# Supabase Postgres — Project Settings > Database > Connection string.
#
# The app connects as app_user, which is subject to row-level security.
# Create it with `npm run db:provision`, which prints this line for you.
DATABASE_URL=postgresql://app_user:<password>@db.<project-ref>.supabase.co:5432/postgres

# Owner connection (the postgres role). Only for applying schema.sql and
# provisioning app_user; the app itself never uses it.
ADMIN_DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# OpenAI — prescription scanning (vision) and voice transcription
OPENAI_API_KEY=sk-...
# Optional: model that reads prescriptions (default gpt-5.5)
# OPENAI_VISION_MODEL=gpt-5.5
# Optional: MediMitra voice assistant models
# OPENAI_CHAT_MODEL=gpt-5.5
# OPENAI_STT_MODEL=gpt-4o-transcribe
# OPENAI_TTS_MODEL=gpt-4o-mini-tts
# OPENAI_TTS_VOICE=coral

# Public origin for family share links (set in production)
# APP_URL=https://medimantra.example.com

# Session cookie signing key — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
